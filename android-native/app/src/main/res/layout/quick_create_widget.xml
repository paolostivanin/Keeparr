<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_background" android:padding="4dp">
    <LinearLayout android:id="@+id/quick_create_note" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center" android:minHeight="48dp"
        android:contentDescription="Create a note" android:background="@drawable/widget_card" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_text_action" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="Note" android:textColor="@color/widget_text_action" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/quick_create_checklist" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="4dp" android:orientation="horizontal" android:gravity="center" android:minHeight="48dp"
        android:contentDescription="Create a checklist" android:background="@drawable/widget_card" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_check_on"
            android:tint="@color/widget_text_action" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="List" android:textColor="@color/widget_text_action" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
