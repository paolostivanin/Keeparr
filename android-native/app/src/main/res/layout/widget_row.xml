<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="48dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_card">
    <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#292720" android:maxLines="2" />
    <TextView android:id="@+id/row_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#49463E" android:maxLines="4" />
    <LinearLayout android:id="@+id/row_checks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
</LinearLayout>
