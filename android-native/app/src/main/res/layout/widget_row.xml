<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/widget_note_card"
    android:clipToOutline="true">
    <ImageView android:id="@+id/widget_card_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_note_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/row_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/widget_text_secondary" android:maxLines="6" android:ellipsize="end" />
        <LinearLayout android:id="@+id/row_checks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
        <TextView android:id="@+id/row_reminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <ImageView android:id="@+id/row_shared" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginTop="4dp"
            android:src="@drawable/ic_shared_note" android:contentDescription="Shared note" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
