<resources>
    <color name="ic_launcher_background">#FBBC04</color>
    <!-- Window background behind the Compose content: shows during launch, so it matches the app surface. -->
    <color name="window_background">#FFFFFF</color>
    <!-- Widgets (RemoteViews cannot use Compose); values-night/colors.xml has the dark variants. -->
    <color name="widget_background">#FFF8E9</color>
    <color name="widget_card">#FFFFFF</color>
    <color name="widget_note_card">#FFFFFF</color>
    <color name="widget_fab">#FDD663</color>
    <color name="widget_fab_stroke">#E6C452</color>
    <color name="widget_fab_icon">#3C3529</color>
    <color name="widget_text">#202124</color>
    <color name="widget_text_secondary">#49463E</color>
    <!-- The status chip is tonal, in the + button's yellow family, so it reads as a button; its text and icon use widget_text_action. -->
    <color name="widget_chip">#FDE293</color>
    <!-- Neutral, so it shows on the chip in both themes: a forced theme cannot recolor a ripple. -->
    <color name="widget_chip_ripple">#33808080</color>
    <color name="widget_text_action">#3C3529</color>
</resources>
