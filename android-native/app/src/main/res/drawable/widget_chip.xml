<?xml version="1.0" encoding="utf-8"?>
<!-- The status chip: a 40dp tonal pill inside a 48dp touch box (the 4dp insets), with a ripple clipped to the same pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_chip_ripple">
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle"><solid android:color="@color/widget_chip" /><corners android:radius="20dp" /></shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle"><solid android:color="#FFFFFF" /><corners android:radius="20dp" /></shape>
        </inset>
    </item>
</ripple>
